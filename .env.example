# Required: token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use /winnerlist and /stats
ADMIN_IDS=

# Required webhook endpoint and Telegram request-verification secret
WEBHOOK_URL=https://bot.example.com/telegram
WEBHOOK_SECRET=

# Internal webhook listener (usually behind a TLS reverse proxy)
WEBHOOK_LISTEN=0.0.0.0
PORT=8080

# Optional tuning (defaults shown; WIN_CHANCE must be at least 9)
WIN_CHANCE=100
COOLDOWN_HOURS=24
PRIZE_AMOUNT=10000
PRIZE_TOKEN=SOLDUCK

# Optional for non-Docker runs. Docker defaults to /app/data/solduck.db.
# DB_PATH=solduck.db
